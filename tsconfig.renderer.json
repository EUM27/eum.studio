{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "noEmit": true
  },
  "include": [
    "src/domain/**/*.ts",
    "src/application/**/*.ts",
    "src/renderer/**/*.ts",
    "src/renderer/**/*.tsx",
    "vite.config.ts"
  ]
}
