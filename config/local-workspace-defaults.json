{
  "schemaVersion": 1,
  "anchorPolicy": {
    "schemaVersion": 1,
    "version": "local-workspace-anchor-v1",
    "contextOffsetLength": 64
  },
  "anchorEvidenceChecksumAlgorithm": "sha256",
  "manuscriptBatchingPolicy": {
    "schemaVersion": 1,
    "maxTransactionsPerBatch": 32,
    "maxDelayMs": 450
  },
  "activityPolicy": {
    "idleTimeout": 0,
    "navigationGrace": 0,
    "hiddenWindowPolicy": "disabled",
    "activityClassRules": [],
    "autoStartEnabled": false,
    "autoResumeFromIdle": false,
    "recoveryPolicy": "manual"
  },
  "focusPolicy": {
    "phaseDefinitions": [],
    "backgroundPolicy": "disabled",
    "musicStartPolicy": "manual",
    "completionPolicy": "manual",
    "visibility": "hidden"
  },
  "sceneRuleSet": {
    "displayName": "기본 장면 규칙",
    "boundaryRules": [
      {
        "boundaryRuleId": "legacy-asterisk-divider",
        "kind": "line-regexp",
        "pattern": "^\\s*\\*\\*\\*\\s*$",
        "flags": "u"
      }
    ],
    "normalizationPolicy": "preserve",
    "enabled": true
  },
  "plotBoard": {
    "defaultBoardTitle": "기본 플롯 보드",
    "defaultLaneTitle": "기본 흐름",
    "orderKeyLengthLimit": 128
  },
  "railPreferences": {}
}
